{
  "name": "mam-neural-lab",
  "version": "0.1.0",
  "private": true,
  "description": "A local visual neural learning classroom",
  "license": "MIT",
  "scripts": {
    "start": "electron scripts/classroom.cjs",
    "test": "node --test scripts/classroom.test.mjs tests/language.test.mjs tests/dialogue.test.mjs tests/turn-memory.test.mjs tests/cooperation.test.mjs tests/subword.test.mjs",
    "train": "node scripts/classroom-train.mjs",
    "test:ui": "node scripts/classroom-smoke.mjs",
    "test:transfer": "node scripts/classroom-transfer.mjs",
    "train:language": "node scripts/language-experiment.mjs",
    "train:dialogue": "node scripts/language-conditioned.mjs",
    "chat": "electron scripts/classroom.cjs --conversation",
    "test:dialogue:ui": "node scripts/dialogue-smoke.mjs",
    "train:context": "node scripts/language-context.mjs",
    "test:cooperation": "node --test tests/cooperation.test.mjs",
    "test:public-gru": "node scripts/public-gru-parity.mjs",
    "chat:research": "node scripts/public-gru-chat.mjs"
  },
  "devDependencies": {
    "electron": "42.11.18",
    "playwright": "1.65.1"
  }
}
